# 619 ERP Frontend — env template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local (it's in .gitignore).

# Backend API URL (Render deployment or local)
NEXT_PUBLIC_API_URL=https://six19-erp-api.onrender.com

# Node environment (auto-set by Next.js in production)
# NODE_ENV=production

# Supabase PostgreSQL (for biometric attendance system)
# SUPABASE_DB_URL=postgresql://postgres.project:password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# Custom domain for WebAuthn RP_ID (required when deploying to a custom domain)
# NEXT_PUBLIC_APP_DOMAIN=your-custom-domain.com
